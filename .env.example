# AITrader environment variables (copy to .env, fill in, do NOT commit .env)

# ── Database (本机 PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://localhost/aitrader

# ── Outbound SMTP (可选: 健康巡检告警邮件) ──────────────────────────
AITRADER_SMTP_HOST=
AITRADER_SMTP_PORT=465
AITRADER_SMTP_USE_SSL=1
AITRADER_SMTP_USER=
AITRADER_SMTP_PASSWORD=
AITRADER_SMTP_FROM_NAME=AITrader
